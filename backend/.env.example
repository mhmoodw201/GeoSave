# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or local).
# Leave empty in development to use the embedded database with demo data
# (stored in backend/.data). Required in production.
MONGODB_URI=

# Long random secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login stays valid, in days
SESSION_DAYS=7

# Comma-separated list of extra origins allowed to call the API (only needed
# if the frontend is hosted on a different origin than the API).
CORS_ORIGINS=

# Set to the number of reverse proxies in front of the app (e.g. 1 behind nginx)
TRUST_PROXY=0

# Maximum upload size in megabytes
MAX_UPLOAD_MB=5
